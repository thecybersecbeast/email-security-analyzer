# Copy to .env and fill in real values for local development.
# Never commit a real .env file — it's already in .gitignore.

# IMAP password for `watch --imap-host ...` (see README's "Real-time
# monitoring" section). For Gmail/Outlook this must be an app password,
# not your normal account password.
EMAIL_ANALYZER_IMAP_PASSWORD=

# Optional: override which environment variable name `watch` reads the
# IMAP password from, via `--imap-password-env`. Only needed if you don't
# want to use the default name above.
# EMAIL_ANALYZER_IMAP_PASSWORD=your-app-password
